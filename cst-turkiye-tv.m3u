# M3U oluştur
lines = [
    "#EXTM3U",
    "# CST DİJİTAL — TÜRKİYE FULL AÇIK TV",
    "# 100+ kamuya açık / ücretsiz internet yayını",
    "# Halk TV özellikle dahil edilmemiştir.",
    "# Ücretli/premium spor kanalları dahil edilmemiştir.",
    ""
]

for name, tvgid, group, url in channels:
    lines.append(
        f'#EXTINF:-1 tvg-id="{tvgid}" tvg-name="{name}" tvg-country="TR" group-title="{group}",{name}'
    )
    lines.append(url)
    lines.append("")

path = Path("/mnt/data/CST_Turkiye_Full_100Plus.m3u")
path.write_text("\n".join(lines), encoding="utf-8")

print(f"✅ CST Türkiye Full oluşturuldu: {len(channels)} kanal")
print(f"📁 {path}")
